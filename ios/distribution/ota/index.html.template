<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Install Audiobookshelf</title>
<style>
  :root{
    --bg:#f2f2f7;
    --card:#ffffff;
    --text:#1c1c1e;
    --muted:#6b6b70;
    --accent:#007aff;
    --accent-text:#ffffff;
    --border:#e5e5ea;
    --warn-bg:#fff4e5;
    --warn-text:#8a5a00;
  }
  @media (prefers-color-scheme: dark){
    :root{
      --bg:#000000;
      --card:#1c1c1e;
      --text:#f2f2f7;
      --muted:#9a9a9e;
      --accent:#0a84ff;
      --accent-text:#ffffff;
      --border:#3a3a3c;
      --warn-bg:#3a2e12;
      --warn-text:#f5c453;
    }
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
    display:flex;
    justify-content:center;
    padding:48px 20px;
    min-height:100vh;
  }
  .card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:20px;
    padding:32px 28px;
    max-width:400px;
    width:100%;
    text-align:center;
  }
  .icon{
    width:96px;
    height:96px;
    border-radius:22px;
    margin:0 auto 20px;
    display:block;
    box-shadow:0 4px 16px rgba(0,0,0,.15);
  }
  h1{
    font-size:22px;
    margin:0 0 4px;
  }
  .version{
    color:var(--muted);
    font-size:14px;
    margin:0 0 24px;
  }
  .install-btn{
    display:block;
    width:100%;
    padding:14px 20px;
    background:var(--accent);
    color:var(--accent-text);
    border-radius:14px;
    font-size:17px;
    font-weight:600;
    text-decoration:none;
    margin-bottom:20px;
  }
  .install-btn:active{
    opacity:.8;
  }
  .steps{
    text-align:left;
    font-size:14px;
    color:var(--muted);
    line-height:1.5;
    padding-left:20px;
    margin:0 0 20px;
  }
  .steps li{margin-bottom:8px;}
  .steps li:last-child{margin-bottom:0;}
  .warning{
    background:var(--warn-bg);
    color:var(--warn-text);
    border-radius:12px;
    padding:12px 14px;
    font-size:13px;
    line-height:1.5;
    text-align:left;
    display:none;
  }
  code{
    background:rgba(127,127,127,.15);
    padding:1px 5px;
    border-radius:4px;
    font-size:12px;
  }
</style>
</head>
<body>
  <div class="card">
    <img class="icon" src="icon-512.png" alt="Audiobookshelf icon">
    <h1>Audiobookshelf</h1>
    <p class="version">Version __VERSION__ (__BUILD__)</p>

    <a id="installBtn" class="install-btn" href="itms-services://?action=download-manifest&amp;url=__BASE_URL__/manifest.plist">
      Install on this iPhone
    </a>

    <ol class="steps">
      <li>Open this page in <strong>Safari</strong> on the iPhone you want to install to.</li>
      <li>Tap <strong>Install on this iPhone</strong> and confirm.</li>
      <li>After it installs, go to <strong>Settings → General → VPN &amp; Device Management</strong> and trust the developer profile.</li>
      <li>The Apple Watch app installs automatically (or from the Watch app on the iPhone → Available Apps). Open it on the watch and tap <strong>Pair with iPhone</strong>.</li>
    </ol>

    <div class="warning" id="notSafariWarning">
      This install link only works in <strong>Safari on iOS</strong>. Open this page directly on the iPhone you want to install to.
    </div>
  </div>

  <script>
    (function(){
      var ua = navigator.userAgent || "";
      var isIOS = /iPad|iPhone|iPod/.test(ua);
      var isSafari = /Safari/.test(ua) && !/CriOS|FxiOS|EdgiOS|OPiOS/.test(ua);
      if (!isIOS || !isSafari) {
        document.getElementById("notSafariWarning").style.display = "block";
      }
    })();
  </script>
</body>
</html>
